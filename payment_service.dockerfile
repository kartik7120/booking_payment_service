FROM alpine

WORKDIR /app

COPY paymentServiceApp .

ARG ENV
ENV ENV=$ENV

ARG DODOPAYMENT_TOKEN
ENV DODOPAYMENT_TOKEN=${DODOPAYMENT_TOKEN}

ARG DB_URL
ENV DB_URL=${DB_URL}

ARG MOVIEDB_URL
ENV MOVIEDB_URL=${MOVIEDB_URL}

ARG REDIRECT_URL
ENV REDIRECT_URL=${REDIRECT_URL}

RUN chmod +x paymentServiceApp

CMD ["./paymentServiceApp"]